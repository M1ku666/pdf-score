{
  "name": "pdf-score",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A score player for PDF sheet music, with automatic page turning, play-along tracks, measure jumping, variable-speed playback, and a metronome.",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "i18n": "node scripts/build-locales.mjs",
    "predev": "npm run assets && npm run i18n",
    "dev": "vite",
    "prebuild": "npm run assets && npm run i18n",
    "build": "vite build",
    "preview": "vite preview --host",
    "preview:dist": "vite preview --host",
    "pretest:unit": "npm run i18n",
    "test:unit": "node scripts/unit-test.mjs",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  }
}
